{
  "name": "banto-vscode",
  "displayName": "番頭",
  "description": "SoftBanto (番頭) のやること・あなたの番・推しの一言・会議の始まりを VS Code に出す",
  "version": "0.1.0",
  "publisher": "softbanto",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryouka0731/agentic-management-gas.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Other"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "banto", "title": "番頭", "icon": "media/banto.svg" }
      ]
    },
    "views": {
      "banto": [
        { "id": "banto.issues", "name": "やること" }
      ]
    },
    "commands": [
      { "command": "banto.refresh", "title": "更新", "category": "番頭", "icon": "$(refresh)" },
      { "command": "banto.showIssue", "title": "やることを見る", "category": "番頭" },
      { "command": "banto.meetingsRefresh", "title": "今日の予定を取り直す", "category": "番頭" }
    ],
    "menus": {
      "view/title": [
        { "command": "banto.refresh", "when": "view == banto.issues", "group": "navigation" }
      ],
      "commandPalette": [
        { "command": "banto.showIssue", "when": "false" }
      ]
    },
    "configuration": {
      "title": "番頭",
      "properties": {
        "banto.kitDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "手元の道具 (番頭の画面から落とした zip) を解凍したフォルダ。中の `agentkit.json` の `queueDir` (命令の入れ先) を使う。空なら `~/.agentkit.json` か `~/.banto/config.json` を見る"
        },
        "banto.email": {
          "type": "string",
          "default": "",
          "description": "自分のアドレス。やることの一覧を自分の担当で絞る (空なら open なものを全部出す)"
        },
        "banto.pollMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "あなたの番 (確認依頼・戻ってきたもの・期限) を何分ごとに見るか"
        },
        "banto.meetings.autoOpen": {
          "type": "boolean",
          "default": false,
          "description": "会議の始まりに、押さなくても会議の URL (Google Meet) を開く。URL が無い予定は知らせだけ"
        },
        "banto.oshi.show": {
          "type": "boolean",
          "default": true,
          "description": "ステータスバーに推しの名前と一言を出す (番頭で推しがオフなら出ない)"
        }
      }
    }
  }
}
