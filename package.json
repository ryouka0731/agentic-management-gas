{
  "name": "agentic-management-gas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "push": "clasp push -f",
    "deploy": "node scripts/deploy.mjs",
    "secrets": "command -v trufflehog >/dev/null 2>&1 || { echo 'trufflehog が見つかりません。brew install trufflehog で入れてください' >&2; exit 1; }; trufflehog git file://. --results=verified --fail --no-update",
    "coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=json-summary",
    "metrics": "node scripts/metrics.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "^30.0.1",
    "vitest": "4.1.11"
  }
}
